{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BengaluruGeographicLocation",
  "type": "object",
  "required": [
    "location_id",
    "name_en",
    "name_kn",
    "category",
    "latitude",
    "longitude",
    "ward_or_area",
    "source"
  ],
  "properties": {
    "location_id": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "name_kn": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "transit_hub",
        "tech_park",
        "commercial",
        "residential",
        "interchange",
        "educational"
      ]
    },
    "latitude": {
      "type": "number",
      "minimum": 12.7,
      "maximum": 13.25
    },
    "longitude": {
      "type": "number",
      "minimum": 77.35,
      "maximum": 77.85
    },
    "ward_or_area": {
      "type": "string"
    },
    "wheelchair_accessible": {
      "type": "boolean"
    },
    "source": {
      "type": "string"
    },
    "verified_at": {
      "type": "string"
    }
  }
}
