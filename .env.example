# ============================================================================
# TRIPBUDDY AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the required values.
# NEVER commit your actual .env file or real credentials to version control.
# ============================================================================

# --- Application Mode & Core Settings ---
APP_NAME=TripBuddy AI
APP_ENV=development
# Operating mode: "demo" (deterministic verified sample data, zero paid keys required) or "live" (uses configured live providers)
OPERATING_MODE=demo
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Security & Authentication ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET_KEY_GENERATED_VIA_OPENSSL
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=60
JOURNEY_RETENTION_DAYS=30
REDACT_PII_LOGS=true

# --- Database (PostgreSQL + PostGIS + pgvector OR Local SQLite Fallback) ---
DATABASE_URL=postgresql+psycopg://tripbuddy_user:REPLACE_WITH_DB_PASSWORD@localhost:5432/tripbuddy_db
SQLITE_FALLBACK_PATH=./data/tripbuddy_local.sqlite3
USE_SQLITE_FALLBACK=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Cache & Background Workers (Redis) ---
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=4
ENABLE_BACKGROUND_WORKERS=true
MONITORING_POLL_INTERVAL_SECONDS=30

# --- LLM & Embedding Providers ---
# Supported values: "local_RuleAndHybrid", "openai_compatible", "gemini", "ollama"
LLM_PROVIDER=local_RuleAndHybrid
LLM_API_KEY=REPLACE_WITH_LLM_API_KEY_IF_USING_HOSTED_LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15
LLM_MAX_TOKENS=1024
LLM_MAX_COST_USD_PER_REQUEST=0.05
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Geospatial, Maps & Routing Providers ---
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
GEOCODING_PROVIDER=nominatim_osm
GEOCODING_API_KEY=REPLACE_IF_USING_COMMERCIAL_GEOCODER
GEOCODING_USER_AGENT=TripBuddyAI-Bengaluru/1.0
ROAD_ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org

# --- Bengaluru Transport & Live Feed Providers ---
# Note: Official BMTC & BMRCL live APIs require institutional approval from DULT / BMTC / BMRCL.
BMTC_PROVIDER_MODE=gtfs_schedule_and_fixture
BMTC_GTFS_RT_URL=REPLACE_WITH_AUTHORIZED_BMTC_GTFS_RT_ENDPOINT
BMTC_API_KEY=REPLACE_WITH_AUTHORIZED_BMTC_API_KEY

NAMMA_METRO_PROVIDER_MODE=schedule_and_fixture
NAMMA_METRO_API_URL=REPLACE_WITH_AUTHORIZED_BMRCL_API_ENDPOINT
NAMMA_METRO_API_KEY=REPLACE_WITH_AUTHORIZED_BMRCL_API_KEY
NAMMA_METRO_WHATSAPP_TICKETING_URL=https://wa.me/918105556677

# --- Traffic, Weather & Civic Advisories ---
TRAFFIC_PROVIDER=fixture_or_tomtom
TRAFFIC_API_KEY=REPLACE_WITH_TOMTOM_OR_HERE_TRAFFIC_API_KEY
WEATHER_PROVIDER=open_meteo
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
NEWS_ADVISORY_PROVIDER=verified_civic_feeds

# --- Frontend Vite Configuration ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEFAULT_OPERATING_MODE=demo
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
